OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-nano
QDRANT_URL=http://localhost:6333
AI_MODE=openai
REINDEX_SYMBOLS=false
GENERATION_CACHE_ENABLED=true
# GENERATION_CACHE_DIR=.cache/generation
# GENERATION_CACHE_SCHEMA_VERSION=1
RUNS_DIR=runs
LOG_LEVEL=INFO
LOG_API_CALLS=true

# Perfil econômico (defaults — descomente para sobrescrever)
# MAX_LLM_CALLS_PER_SYMBOL=2
# MAX_COVERAGE_ROUNDS=0
# MAX_REPAIRS=1
# COVERAGE_STOP_ON_NO_IMPROVEMENT=true
# REPAIR_ERROR_MAX_CHARS=900
# LLM_MAX_OUTPUT_TOKENS=1536
# GENERATION_MAX_TEST_FUNCTIONS=4
# GENERATION_MAX_LINES=80
# INGEST_SKIP_FUNCTION_NAMES=main
# INGEST_SKIP_DIRS=
# INGEST_SKIP_FILE_GLOBS=

# Orçamento e recuperação RAG (opcional)
# PROMPT_MAX_RAG_TOTAL_CHARS=2500
# PROMPT_MAX_RAG_SNIPPET_CHARS=300
# RETRIEVER_TOP_K=3
# RETRIEVER_TOP_K_FUNCTIONS=3
# RETRIEVER_TOP_K_TESTS=2
# RETRIEVER_RERANK_POOL_SIZE=10
# RETRIEVER_SCORE_THRESHOLD=0.55
